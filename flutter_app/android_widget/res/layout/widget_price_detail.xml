<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_card_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/widget_pig"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="전국 평균 돈가" android:textSize="15sp" android:textStyle="bold" android:textColor="#111827"/><TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#6B7280"/></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom"><TextView android:id="@+id/price_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="31sp" android:textStyle="bold" android:textColor="#0B1B3B"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginBottom="5dp" android:text="원/kg" android:textSize="12sp" android:textStyle="bold" android:textColor="#111827"/></LinearLayout><TextView android:id="@+id/price_change" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="13sp" android:textStyle="bold"/><TextView android:id="@+id/widget_data_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#8B8F98"/></LinearLayout>
        <ImageView android:id="@+id/sparkline" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginStart="10dp" android:scaleType="fitXY" android:contentDescription="@null"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/widget_divider"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:weightSum="3">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:text="어제" android:textColor="#747884" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/price_yesterday" android:text="-" android:textStyle="bold" android:textColor="#111827" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:text="전주" android:textColor="#747884" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/price_week" android:text="-" android:textStyle="bold" android:textColor="#111827" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:text="전년동일" android:textColor="#747884" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/price_year" android:text="-" android:textStyle="bold" android:textColor="#111827" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
    </LinearLayout>
</LinearLayout>
