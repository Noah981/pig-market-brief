<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="16dp" android:background="@drawable/widget_card_bg" android:weightSum="3">
 <LinearLayout android:id="@+id/price_section" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingEnd="11dp"><ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/widget_pig"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="전국 평균 돈가" android:textColor="#111827" android:textSize="12sp" android:textStyle="bold"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom"><TextView android:id="@+id/price_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="#0B1B3B" android:textSize="25sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text=" 원/kg" android:textSize="10sp" android:textStyle="bold"/></LinearLayout><TextView android:id="@+id/price_change" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="-" android:textSize="11sp" android:textStyle="bold"/><TextView android:id="@+id/widget_data_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#8B8F98"/></LinearLayout>
 <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@drawable/widget_divider"/>
 <LinearLayout android:id="@+id/weather_section" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="11dp"><TextView android:id="@+id/weather_region" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:text="지역 확인 중" android:textColor="#5B3D48" android:textSize="11sp" android:textStyle="bold"/><TextView android:id="@+id/weather_icon" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="☀" android:textSize="27sp"/><TextView android:id="@+id/weather_temp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="-°" android:textColor="#0B1B3B" android:textSize="26sp" android:textStyle="bold"/><TextView android:id="@+id/weather_condition" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="데이터 확인 중" android:textSize="9sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/weather_rain" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="강수확률 -" android:textColor="#2087D4" android:textSize="9sp"/></LinearLayout>
 <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@drawable/widget_divider"/>
 <LinearLayout android:id="@+id/todo_section" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingStart="11dp"><TextView android:id="@+id/todo_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="오늘 할 일 0" android:textColor="#111827" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/todo_1" style="@style/WidgetTodoTextSmall"/><TextView android:id="@+id/todo_2" style="@style/WidgetTodoTextSmall"/><TextView android:id="@+id/todo_3" style="@style/WidgetTodoTextSmall"/></LinearLayout>
</LinearLayout>
