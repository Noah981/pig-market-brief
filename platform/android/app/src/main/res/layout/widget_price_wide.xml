<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/dondonhae_icon_foreground" android:contentDescription="돈돈해"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="돈돈해" android:textColor="#4B2F28" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="마지막 확인 기준" android:textColor="#777B85" android:textSize="9sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="오늘의 전국 돈가" android:textColor="#4B2F28" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/widget_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="마지막 가격 확인 중" android:textColor="#111111" android:textSize="32sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="32sp"/>
            <TextView android:id="@+id/widget_change" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="전일 대비 확인 중" android:textColor="#777B85" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
        <ImageView android:id="@+id/widget_sparkline" android:layout_width="105dp" android:layout_height="58dp" android:layout_marginStart="8dp" android:scaleType="fitCenter" android:contentDescription="최근 돈가 흐름"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="양돈의 오늘을 든든하게, 돈돈해" android:textColor="#6D5B54" android:textSize="9sp"/>
</LinearLayout>
